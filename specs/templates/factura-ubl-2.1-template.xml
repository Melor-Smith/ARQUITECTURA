<?xml version="1.0" encoding="UTF-8"?>
<Invoice xmlns="urn:oasis:names:specification:ubl:schema:xsd:Invoice-2"
         xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
         xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
         xmlns:ccts="urn:un:unece:uncefact:documentation:2"
         xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
         xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2"
         xmlns:qdt="urn:oasis:names:specification:ubl:schema:xsd:QualifiedDatatypes-2"
         xmlns:udt="urn:un:unece:uncefact:data:specification:UnqualifiedDataTypesSchemaModule:2">
    
    <!-- Extensiones SUNAT / Firma Digital / Hash CPE -->
    <ext:UBLExtensions>
        <ext:UBLExtension>
            <ext:ExtensionContent>
                <ds:Signature Id="Signature-ABC">
                    <ds:SignedInfo>
                        <ds:CanonicalizationMethod Algorithm="http://www.w3.org/2001/10/xml-exc-c14n#"/>
                        <ds:SignatureMethod Algorithm="http://www.w3.org/2001/04/xmldsig-more#rsa-sha256"/>
                        <ds:Reference URI="">
                            <ds:DigestMethod Algorithm="http://www.w3.org/2001/04/xmlenc#sha256"/>
                            <ds:DigestValue>ZGIwMTM4NmY0YTIwYjY5YjdhM2EyY2Y2Y2ViMGNhMmQ=</ds:DigestValue>
                        </ds:Reference>
                    </ds:SignedInfo>
                    <ds:SignatureValue>MOCK_SIGNATURE_VALUE_ABC_SOFTWARE_CORP==</ds:SignatureValue>
                </ds:Signature>
            </ext:ExtensionContent>
        </ext:UBLExtension>
    </ext:UBLExtensions>

    <!-- Versión del estándar UBL y estructura SUNAT -->
    <cbc:UBLVersionID>2.1</cbc:UBLVersionID>
    <cbc:CustomizationID>2.0</cbc:CustomizationID>

    <!-- Identificador Principal de la Factura: serie_numero (Formato SUNAT: F001-000001) -->
    <cbc:ID>F001-000001</cbc:ID>
    <cbc:IssueDate>2026-10-22</cbc:IssueDate>
    <cbc:IssueTime>10:30:00</cbc:IssueTime>

    <!-- Catálogo 01: 01 = Factura Electrónica -->
    <cbc:InvoiceTypeCode listID="0101">01</cbc:InvoiceTypeCode>

    <!-- Catálogo 02: Moneda PEN = Soles -->
    <cbc:DocumentCurrencyCode>PEN</cbc:DocumentCurrencyCode>

    <!-- Trazabilidad con el Sistema de Almacén Legado de ABC Software Corp -->
    <cac:DespatchDocumentReference>
        <cbc:ID>VALE-SALIDA-0042</cbc:ID>
        <cbc:DocumentTypeCode>09</cbc:DocumentTypeCode>
    </cac:DespatchDocumentReference>

    <!-- Emisor: ABC Software Corp S.A.C. -->
    <cac:AccountingSupplierParty>
        <cac:Party>
            <cac:PartyIdentification>
                <cbc:ID schemeID="6">20556677889</cbc:ID>
            </cac:PartyIdentification>
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>ABC SOFTWARE CORP S.A.C.</cbc:RegistrationName>
                <cac:RegistrationAddress>
                    <cbc:ID>150101</cbc:ID>
                    <cac:AddressLine>
                        <cbc:Line>AV. INDUSTRIAL 450 - LIMA</cbc:Line>
                    </cac:AddressLine>
                </cac:RegistrationAddress>
            </cac:PartyLegalEntity>
        </cac:Party>
    </cac:AccountingSupplierParty>

    <!-- Adquiriente: Cliente Mayorista/Minorista -->
    <cac:AccountingCustomerParty>
        <cac:Party>
            <cac:PartyIdentification>
                <cbc:ID schemeID="6">20123456789</cbc:ID>
            </cac:PartyIdentification>
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>DISTRIBUIDORA DE ABARROTES EL SOL S.A.C.</cbc:RegistrationName>
                <cac:RegistrationAddress>
                    <cbc:ID>150102</cbc:ID>
                    <cac:AddressLine>
                        <cbc:Line>JR. COMERCIO 123 - LIMA</cbc:Line>
                    </cac:AddressLine>
                </cac:RegistrationAddress>
            </cac:PartyLegalEntity>
        </cac:Party>
    </cac:AccountingCustomerParty>

    <!-- Impuestos Totales: IGV e ISC (Catálogo 08) -->
    <cac:TaxTotal>
        <cbc:TaxAmount currencyID="PEN">51.00</cbc:TaxAmount>
        <!-- Subtotal IGV (18%) -->
        <cac:TaxSubtotal>
            <cbc:TaxableAmount currencyID="PEN">200.00</cbc:TaxableAmount>
            <cbc:TaxAmount currencyID="PEN">36.00</cbc:TaxAmount>
            <cac:TaxCategory>
                <cac:TaxScheme>
                    <cbc:ID>1000</cbc:ID>
                    <cbc:Name>IGV</cbc:Name>
                    <cbc:TaxTypeCode>VAT</cbc:TaxTypeCode>
                </cac:TaxScheme>
            </cac:TaxCategory>
        </cac:TaxSubtotal>
        <!-- Subtotal ISC (Catálogo 08: 01 Al Valor) -->
        <cac:TaxSubtotal>
            <cbc:TaxableAmount currencyID="PEN">200.00</cbc:TaxableAmount>
            <cbc:TaxAmount currencyID="PEN">15.00</cbc:TaxAmount>
            <cac:TaxCategory>
                <cbc:TierRange>01</cbc:TierRange>
                <cac:TaxScheme>
                    <cbc:ID>2000</cbc:ID>
                    <cbc:Name>ISC</cbc:Name>
                    <cbc:TaxTypeCode>EXC</cbc:TaxTypeCode>
                </cac:TaxScheme>
            </cac:TaxCategory>
        </cac:TaxSubtotal>
    </cac:TaxTotal>

    <!-- Importes Totales Monetarios -->
    <cac:LegalMonetaryTotal>
        <cbc:LineExtensionAmount currencyID="PEN">200.00</cbc:LineExtensionAmount>
        <cbc:TaxInclusiveAmount currencyID="PEN">251.00</cbc:TaxInclusiveAmount>
        <cbc:PayableAmount currencyID="PEN">251.00</cbc:PayableAmount>
    </cac:LegalMonetaryTotal>

    <!-- Línea 1: Venta de Mercadería de Abarrotes -->
    <cac:InvoiceLine>
        <cbc:ID>1</cbc:ID>
        <cbc:InvoicedQuantity unitCode="NIU">2.00</cbc:InvoicedQuantity>
        <cbc:LineExtensionAmount currencyID="PEN">200.00</cbc:LineExtensionAmount>
        <cac:PricingReference>
            <cac:AlternativeConditionPrice>
                <cbc:PriceAmount currencyID="PEN">125.50</cbc:PriceAmount>
                <cbc:PriceTypeCode>01</cbc:PriceTypeCode>
            </cac:AlternativeConditionPrice>
        </cac:PricingReference>
        <cac:TaxTotal>
            <cbc:TaxAmount currencyID="PEN">51.00</cbc:TaxAmount>
            <cac:TaxSubtotal>
                <cbc:TaxableAmount currencyID="PEN">200.00</cbc:TaxableAmount>
                <cbc:TaxAmount currencyID="PEN">36.00</cbc:TaxAmount>
                <cac:TaxCategory>
                    <cbc:Percent>18.00</cbc:Percent>
                    <cac:TaxScheme>
                        <cbc:ID>1000</cbc:ID>
                        <cbc:Name>IGV</cbc:Name>
                        <cbc:TaxTypeCode>VAT</cbc:TaxTypeCode>
                    </cac:TaxScheme>
                </cac:TaxCategory>
            </cac:TaxSubtotal>
            <cac:TaxSubtotal>
                <cbc:TaxableAmount currencyID="PEN">200.00</cbc:TaxableAmount>
                <cbc:TaxAmount currencyID="PEN">15.00</cbc:TaxAmount>
                <cac:TaxCategory>
                    <cbc:TierRange>01</cbc:TierRange>
                    <cac:TaxScheme>
                        <cbc:ID>2000</cbc:ID>
                        <cbc:Name>ISC</cbc:Name>
                        <cbc:TaxTypeCode>EXC</cbc:TaxTypeCode>
                    </cac:TaxScheme>
                </cac:TaxCategory>
            </cac:TaxSubtotal>
        </cac:TaxTotal>
        <cac:Item>
            <cbc:Description>Saco de Arroz Extra 50kg</cbc:Description>
            <cac:SellersItemIdentification>
                <cbc:ID>AB-ARR-001</cbc:ID>
            </cac:SellersItemIdentification>
        </cac:Item>
        <cac:Price>
            <cbc:PriceAmount currencyID="PEN">100.00</cbc:PriceAmount>
        </cac:Price>
    </cac:InvoiceLine>
</Invoice>
