# Los XML de referencia de las pruebas de generación se comparan byte a byte:
# git no debe convertir sus saltos de línea en ningún sistema operativo.
tests/unit/generacion_xml/esperados/*.xml -text
# XSD oficiales: se conservan tal como los publica OASIS.
specs/contracts/ubl-2.1/xsd/**/*.xsd -text
*.xls binary
# TXT del PLE: el CRLF es parte del formato; se guardan byte a byte.
docs/ejemplos/*.txt -text
# Paquete de validación PLE: se guarda byte a byte (CRLF y archivos vacíos son parte del formato).
docs/evidencia-ple/paquete/** -text
# Evidencia de SUNAT beta: XML firmados y respuestas tal como viajaron (la firma depende de cada byte).
docs/evidencia-sunat/** -text
# Evidencia del OSE-DEMO de Nubefact: XML y CDR tal como se enviaron y recibieron.
docs/evidencia-nubefact/*.xml -text
tests/fixtures/** -text
# Binarios: diagramas renderizados e informe.
*.png binary
*.pdf binary
*.docx binary
# El lanzador de Windows necesita CRLF.
*.bat text eol=crlf
